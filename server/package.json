{
  "name": "@panopticon/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PANOPTICON // OS — realtime node server: runs the authoritative EngineHost, streams world state to browser clients over WebSocket, accepts commands, and persists rolling state to SQLite.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "systeminformation": "^5.33.0",
    "ws": "^8.21.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "~5.6.3"
  }
}
